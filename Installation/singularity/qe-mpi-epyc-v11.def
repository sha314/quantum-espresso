Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Shahnoor
    Version 11.0
    Quantum ESPRESSO v7.5 optimized for AMD EPYC HPC clusters with support for InfiniBand

%environment

    
    export OMP_NUM_THREADS=1
    export OMPI_MCA_btl=self,vader,tcp
    export OMPI_MCA_pml=ucx
    export UCX_TLS=rc,self,sm
    export UCX_NET_DEVICES=mlx5_0:1


    # UCX
    export PATH=/opt/ucx/bin:$PATH
    export LD_LIBRARY_PATH=/opt/ucx/lib:$LD_LIBRARY_PATH

    # MPI
    export PATH=/opt/openmpi_gnu/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi_gnu/lib:$LD_LIBRARY_PATH

    # OpenBLAS
    export LD_LIBRARY_PATH=/opt/openblas/lib:$LD_LIBRARY_PATH

    # FFTW
    export LD_LIBRARY_PATH=/opt/fftw/lib:$LD_LIBRARY_PATH

    # ScaLAPACK
    export LD_LIBRARY_PATH=/opt/scalapack/lib64:/opt/scalapack/lib:$LD_LIBRARY_PATH

    # Parallel HDF5
    export PATH=/opt/hdf5/bin:$PATH
    export LD_LIBRARY_PATH=/opt/hdf5/lib:$LD_LIBRARY_PATH

    # Quantum ESPRESSO. 7.3
    export PATH=/opt/qe/bin:$PATH
    export LD_LIBRARY_PATH=/opt/qe/lib:$LD_LIBRARY_PATH

    # Phoebe v1.1.0
    export PATH=/opt/phoebe/bin:$PATH



%post

    export DEBIAN_FRONTEND=noninteractive
cat >/etc/ld.so.conf.d/hpc-libs.conf <<EOF
/opt/openmpi/lib
/opt/openblas/lib
/opt/fftw/lib
/opt/scalapack/lib64
/opt/scalapack/lib
/opt/hdf5/lib
EOF

##################################################
# System dependencies
##################################################

    apt-get update

    apt-get install -y \
        build-essential \
        gfortran \
        wget \
        curl \
        git \
        make \
        perl \
        python3 \
        python3-pip \
        libnuma-dev \
        libhwloc-dev \
        gnuplot \
        vim \
        nano \
        ca-certificates

##################################################
# Global optimized compiler flags for EPYC
##################################################

    export CFLAGS="-O3 -march=znver2 -fPIC"
    export FCFLAGS="-O3 -march=znver2 -fPIC -fallow-argument-mismatch"
    export FFLAGS="$FCFLAGS"

##################################################
# CMAKE 
##################################################
    cd /tmp
    wget https://github.com/Kitware/CMake/releases/download/v3.28.4/cmake-3.28.4-linux-x86_64.tar.gz
    tar xf cmake-3.28.4-linux-x86_64.tar.gz
    mv cmake-3.28.4-linux-x86_64 /opt/cmake
    ln -s /opt/cmake/bin/cmake /usr/local/bin/cmake
    ln -s /opt/cmake/bin/ctest /usr/local/bin/ctest

##################################################
# UCX (REQUIRED for InfiniBand)
##################################################

    cd /tmp

    wget https://github.com/openucx/ucx/archive/refs/tags/v1.21.0.tar.gz
    tar xf v1.21.0.tar.gz 
    cd ucx-1.21.0

    ./autogen.sh
    ./configure --prefix=/opt/ucx \
        --enable-mt \
        --without-go \
        --disable-tests \
        CC=gcc CXX=g++

    make -j$(nproc)
    make install

##################################################
# OpenMPI (same toolchain for everything) with UCX 
##################################################

    cd /tmp

    wget https://download.open-mpi.org/release/open-mpi/v4.1/openmpi-4.1.6.tar.gz

    tar xf openmpi-4.1.6.tar.gz

    cd openmpi-4.1.6

    ./configure \
        --prefix=/opt/openmpi \
        --with-ucx=/opt/ucx \
        --enable-mpi-fortran \
        CC=gcc \
        CXX=g++ \
        FC=gfortran

    make -j$(nproc)
    make install

    export PATH=/opt/openmpi/bin:$PATH

    export CC=mpicc
    export CXX=mpicxx
    export FC=mpifort
    echo /opt/openmpi/lib > /etc/ld.so.conf.d/openmpi.conf
    ldconfig

##################################################
# OpenBLAS optimized for EPYC
##################################################

    cd /tmp

    wget https://github.com/OpenMathLib/OpenBLAS/archive/refs/tags/v0.3.33.tar.gz

    tar xf v0.3.33.tar.gz 
    cd OpenBLAS-0.3.33/

    mkdir build && cd build

    cmake .. \
        -DCMAKE_C_COMPILER=gcc \
        -DCMAKE_Fortran_COMPILER=gfortran \
        -DUSE_OPENMP=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_INSTALL_PREFIX=/opt/openblas


    make -j$(nproc)
    make install

    echo /opt/openblas/lib > /etc/ld.so.conf.d/openblas.conf
    ldconfig

##################################################
# FFTW3 MPI build
##################################################

    cd /tmp

    wget https://www.fftw.org/fftw-3.3.10.tar.gz

    tar xf fftw-3.3.10.tar.gz

    cd fftw-3.3.10

    ./configure \
        --prefix=/opt/fftw \
        --enable-mpi \
        --enable-shared \
        CC=mpicc

    make -j$(nproc)

    make install


##################################################
# ScaLAPACK (fixed version)
##################################################

    cd /tmp

    wget https://github.com/Reference-ScaLAPACK/scalapack/archive/v2.2.1.tar.gz

    tar xf v2.2.1.tar.gz

    cd scalapack-2.2.1

    mkdir build
    cd build

cmake .. \
    -DCMAKE_INSTALL_PREFIX=/opt/scalapack \
    -DCMAKE_C_COMPILER=mpicc \
    -DCMAKE_Fortran_COMPILER=mpifort \
    -DBUILD_SHARED_LIBS=ON \
    -DBLAS_LIBRARIES=/opt/openblas/lib/libopenblas.so \
    -DLAPACK_LIBRARIES=/opt/openblas/lib/libopenblas.so 

    make -j$(nproc)
    make install

    echo /opt/scalapack/lib > /etc/ld.so.conf.d/scalapack.conf
    echo /opt/scalapack/lib64 >> /etc/ld.so.conf.d/scalapack.conf
    ldconfig

##################################################
# Parallel HDF5
##################################################
    cd /tmp
    git clone https://github.com/HDFGroup/hdf5.git
    cd hdf5

    git checkout hdf5_2.1.0
    mkdir build && cd build

    cmake .. \
    -DCMAKE_INSTALL_PREFIX=/opt/hdf5 \
    -DCMAKE_C_COMPILER=mpicc \
    -DCMAKE_Fortran_COMPILER=mpifort \
    -DHDF5_BUILD_FORTRAN=ON \
    -DHDF5_ENABLE_PARALLEL=ON \
    -DBUILD_SHARED_LIBS=ON \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DHDF5_BUILD_CPP_LIB=OFF \
    -DHDF5_BUILD_TOOLS=ON \
    -DHDF5_BUILD_EXAMPLES=OFF \
    -DBUILD_TESTING=OFF

    make -j$(nproc)
    make install


##################################################
# Quantum ESPRESSO build with Phoebe support
##################################################
   cd /tmp

   git clone --depth 1 --branch qe-7.5 https://github.com/QEF/q-e.git
   cd q-e
   git submodule update --init --recursive

   mkdir build
   cd build


   cmake .. \
        -DCMAKE_INSTALL_PREFIX=/opt/qe \
        -DCMAKE_C_COMPILER=mpicc \
        -DCMAKE_Fortran_COMPILER=mpifort \
        -DCMAKE_BUILD_TYPE=Release \
        -DQE_ENABLE_MPI=ON \
        -DQE_ENABLE_SCALAPACK=ON \
        -DQE_ENABLE_HDF5=ON  \
        -DQE_FFTW_VENDOR=Internal \
        -DHDF5_ROOT=/opt/hdf5 \
        -DBLAS_LIBRARIES=/opt/openblas/lib/libopenblas.so \
        -DLAPACK_LIBRARIES=/opt/openblas/lib/libopenblas.so \
        -DSCALAPACK_DIR=/opt/scalapack \
        -DFFTW3_ROOT=/opt/fftw


   make -j$(nproc)
   make install



##################################################
# Cleanup
##################################################

    rm -rf /tmp/openmpi*
    rm -rf /tmp/OpenBLAS*
    rm -rf /tmp/fftw*
    rm -rf /tmp/scalapack*
    rm -rf /tmp/hdf5*
    rm -rf /tmp/v*.tar.gz
    rm -rf /tmp/*.tar.gz
    rm -rf /tmp/q-e
    rm -rf /tmp/ucx*
    rm -rf /tmp/openmpi-4.1.6
    rm -rf /tmp/fftw-3.3.10
    rm -rf /tmp/phoebe-quantum-espresso/
    rm -rf /tmp/phoebe*


    apt-get clean


%runscript

    exec /opt/qe/bin/pw.x "$@"
